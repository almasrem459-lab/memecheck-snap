{
  "name": "root",
  "version": "0.1.0",
  "private": true,
  "description": "MemeCheckShield MetaMask Snap monorepo",
  "homepage": "https://memecheck.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/almasrem459-lab/memecheck-snap.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --parallel --verbose --topological run build",
    "build:snap": "yarn workspace @memecheckshield/snap build",
    "clean": "yarn workspaces foreach --parallel --verbose run clean",
    "start": "yarn workspaces foreach --parallel --verbose --interlaced --job=start run start",
    "start:snap": "yarn workspace @memecheckshield/snap start",
    "start:site": "yarn workspace site start",
    "test": "yarn workspace @memecheckshield/snap test",
    "allow-scripts": "allow-scripts"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^3.0.4",
    "prettier": "^3.3.3",
    "typescript": "~5.7.3"
  },
  "packageManager": "yarn@3.2.1",
  "engines": {
    "node": ">=18.6.0"
  }
}
